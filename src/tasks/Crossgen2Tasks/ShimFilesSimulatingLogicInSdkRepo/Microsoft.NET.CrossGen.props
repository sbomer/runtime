<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Crossgen2TasksOverriden>true</Crossgen2TasksOverriden>
    <Crossgen2TasksAssemblyPath Condition="'$(Crossgen2TasksAssemblyPath)' == ''">$(MSBuildThisFileDirectory)Crossgen2Tasks.dll</Crossgen2TasksAssemblyPath>
  </PropertyGroup>

  <UsingTask TaskName="PrepareForReadyToRunCompilation" AssemblyFile="$(Crossgen2TasksAssemblyPath)" />
  <UsingTask TaskName="ResolveReadyToRunCompilers" AssemblyFile="$(Crossgen2TasksAssemblyPath)" />
  <UsingTask TaskName="RunReadyToRunCompiler" AssemblyFile="$(Crossgen2TasksAssemblyPath)" />
</Project>
