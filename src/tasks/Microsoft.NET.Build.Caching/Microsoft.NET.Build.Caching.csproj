<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetCoreAppToolCurrent);$(NetFrameworkToolCurrent)</TargetFrameworks>
    <Description>Reusable caching infrastructure for third-party MSBuild task authors.</Description>
    <IsPackable>true</IsPackable>
    <IsShipping>false</IsShipping>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReadmeFilePath>README.md</PackageReadmeFilePath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <InternalsVisibleTo Include="Microsoft.NET.Build.Caching.Tests" />
    <PackageReference Include="Microsoft.BuildXL.Cache.MemoizationStore.Library" Version="[$(MicrosoftBuildXLVersion)]" />
    <!-- Keep BuildXL's transitive dependencies above known vulnerable versions. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="$(SystemSecurityCryptographyXmlVersion)" />
    <PackageReference Include="System.Text.RegularExpressions" Version="$(SystemTextRegularExpressionsVersion)" />
  </ItemGroup>

</Project>
