<Project Sdk="Microsoft.Build.Traversal">

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppCurrent)-$(TargetOS)</TargetFramework>
    <NoDefaultSlnGenSolutionFolder>true</NoDefaultSlnGenSolutionFolder>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsGraphBuild)' == 'true'">
    <!-- Direct traversal references already describe the graph; synthetic transitive edges bypass their target protocol. -->
    <AddTransitiveProjectReferencesInStaticGraph>false</AddTransitiveProjectReferencesInStaticGraph>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="sfx-src.proj" />
    <ProjectReference Include="sfx-gen.proj" />
    <ProjectReference Include="sfx-finish.proj" />
  </ItemGroup>

</Project>
