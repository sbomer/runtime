<Project Sdk="Microsoft.Build.NoTargets">

  <Import Project="BuildTask.props" Sdk="Microsoft.DotNet.SharedFramework.Sdk" />

  <PropertyGroup>
    <TargetFramework>$(NetCoreAppCurrent)-$(TargetOS)</TargetFramework>
    <NoDefaultSlnGenSolutionFolder>true</NoDefaultSlnGenSolutionFolder>
    <FrameworkListOutputPath>$(MicrosoftNetCoreAppRefPackDataDir)FrameworkList.xml</FrameworkListOutputPath>
    <!-- Import the illink file which contains some of the logic required to illink the shared framework assemblies. -->
    <ExplicitlyImportCustomILLinkTargets>true</ExplicitlyImportCustomILLinkTargets>

    <PackageOverridesInputPath>$(InstallerProjectRoot)pkg\sfx\Microsoft.NETCore.App\PackageOverrides.txt</PackageOverridesInputPath>
    <PackageOverridesOutputPath>$(MicrosoftNetCoreAppRefPackDataDir)PackageOverrides.txt</PackageOverridesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="sfx-src.proj" OutputItemType="SharedFrameworkAssembly" />
    <ProjectReference Include="sfx-gen.proj" OutputItemType="SharedFrameworkAnalyzerAssembly" />

    <PackageReference Include="Microsoft.DotNet.Build.Tasks.Templating" Version="$(MicrosoftDotNetBuildTasksTemplatingVersion)" />
  </ItemGroup>

  <Target Name="GetGenerateFrameworkListFileInputs"
          Deferred="Item:SharedFrameworkAssembly:r;Item:SharedFrameworkAnalyzerAssembly:r;Item:SharedFrameworkAssemblyWithReferenceAssembly:w;Item:SharedFrameworkAssemblyWithoutReferenceAssembly:w;Item:FrameworkListInputFile:w">
    <Error Text="Shared framework assemblies must be built before the framework list can be generated."
           DeferredCondition="'@(SharedFrameworkAssembly)' == '' or '@(SharedFrameworkAnalyzerAssembly)' == ''"
           PrecomputationMode="Dynamic" />

    <ItemGroup>
      <SharedFrameworkAssemblyWithReferenceAssembly Deferred="true"
                                                    Include="%(SharedFrameworkAssembly.Identity)"
                                                    Condition="'%(SharedFrameworkAssembly.IsPrivateAssembly)' == 'false' and '%(SharedFrameworkAssembly.ReferenceAssembly)' != ''" />
      <SharedFrameworkAssemblyWithoutReferenceAssembly Deferred="true"
                                                       Include="%(SharedFrameworkAssembly.Identity)"
                                                       Condition="'%(SharedFrameworkAssembly.IsPrivateAssembly)' == 'false' and '%(SharedFrameworkAssembly.ReferenceAssembly)' == ''" />

      <FrameworkListInputFile Deferred="true"
                              Include="%(SharedFrameworkAssemblyWithReferenceAssembly.ReferenceAssembly)"
                              TargetPath="ref/$(NetCoreAppCurrent)" />
      <FrameworkListInputFile Deferred="true"
                              Include="@(SharedFrameworkAssemblyWithoutReferenceAssembly)"
                              TargetPath="ref/$(NetCoreAppCurrent)" />
      <FrameworkListInputFile Deferred="true"
                              Include="@(SharedFrameworkAnalyzerAssembly)"
                              TargetPath="%(SharedFrameworkAnalyzerAssembly.GeneratorProjectBaseTargetPath)" />
    </ItemGroup>
  </Target>

  <!-- Generate the targeting pack's framework list so that out-of-band projects can leverage it. -->
  <Target Name="GenerateFrameworkListFile"
          DependsOnTargets="GetGenerateFrameworkListFileInputs"
          AfterTargets="Build"
          Outputs="$(FrameworkListOutputPath)"
          Deferred="Item:FrameworkListInputFile:r">
    <ItemGroup>
      <FrameworkListRootAttribute Include="Name" Value="$(NetCoreAppCurrentBrandName)" />
      <FrameworkListRootAttribute Include="TargetFrameworkIdentifier" Value="$(NetCoreAppCurrentIdentifier)" />
      <FrameworkListRootAttribute Include="TargetFrameworkVersion" Value="$(NetCoreAppCurrentVersion)" />
      <FrameworkListRootAttribute Include="FrameworkName" Value="$(MicrosoftNetCoreAppFrameworkName)" />
    </ItemGroup>

    <CreateFrameworkListFile PrecomputationMode="Dynamic"
                             PrecomputeOutputs="$(FrameworkListOutputPath)"
                             Files="@(FrameworkListInputFile)"
                             TargetFile="$(FrameworkListOutputPath)"
                             TargetFilePrefixes="ref/;runtimes/;analyzers/"
                             RootAttributes="@(FrameworkListRootAttribute)" />
  </Target>

  <Target Name="CreatePackageOverrides"
          AfterTargets="Build"
          Inputs="$(PackageOverridesInputPath)"
          Outputs="$(PackageOverridesOutputPath)">
    <ItemGroup>
      <CreatePackageOverridesTemplateProperty Include="ProductVersion=$(ProductVersion)" />
    </ItemGroup>

    <GenerateFileFromTemplate
      TemplateFile="$(PackageOverridesInputPath)"
      Properties="@(CreatePackageOverridesTemplateProperty)"
      OutputPath="$(PackageOverridesOutputPath)" />
  </Target>

  <Target Name="GetSharedFrameworkLayoutInputs"
          Condition="'$(IsPrecomputePhase)' == 'true'">
    <ItemGroup>
      <_SharedFrameworkLayoutProducer Include="@(NetCoreAppLibrary)"
                                      Condition="!$([System.String]::new('%(Identity)').StartsWith('System.Private'))" />
      <_SharedFrameworkLayoutRefDir Include="@(_SharedFrameworkLayoutProducer->'$(MicrosoftNetCoreAppRefPackRefStagingDir)unflattened\%(Identity)#dir')" />
      <_SharedFrameworkLayoutRuntimeDir Include="@(_SharedFrameworkLayoutProducer->'$(MicrosoftNetCoreAppRuntimePackRidLibTfmStagingDir)unflattened\%(Identity)#dir')" />
    </ItemGroup>
  </Target>

  <!-- Consume per-project BinPlace unflattened dirs and copy recorded members into the final pack layout. -->
  <Target Name="CreateSharedFrameworkLayout"
          AfterTargets="Build"
          Condition="'$(IsPrecomputePhase)' == 'true'"
          DependsOnTargets="GetSharedFrameworkLayoutInputs"
          PrecomputeInputs="@(_SharedFrameworkLayoutRefDir);@(_SharedFrameworkLayoutRuntimeDir)"
          PrecomputeOutputs="$(MicrosoftNetCoreAppRefPackRefDir)#dir;$(MicrosoftNetCoreAppRuntimePackRidLibTfmDir)#dir"
          Deferred="Property:MicrosoftNetCoreAppRefPackRefStagingDir:r;Property:MicrosoftNetCoreAppRuntimePackRidLibTfmStagingDir:r;Property:MicrosoftNetCoreAppRefPackRefDir:r;Property:MicrosoftNetCoreAppRuntimePackRidLibTfmDir:r;Item:_StagedRefFile:r;Item:_StagedRefFile:w;Item:_StagedRuntimeLibFile:r;Item:_StagedRuntimeLibFile:w">
    <ItemGroup>
      <_StagedRefFile Deferred="true"
                      Include="$(MicrosoftNetCoreAppRefPackRefStagingDir)unflattened\**\*.*" />
      <_StagedRuntimeLibFile Deferred="true"
                             Include="$(MicrosoftNetCoreAppRuntimePackRidLibTfmStagingDir)unflattened\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_StagedRefFile)"
          DestinationFiles="@(_StagedRefFile->'$(MicrosoftNetCoreAppRefPackRefDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          UseHardlinksIfPossible="true"
          PrecomputationMode="Dynamic" />
    <Copy SourceFiles="@(_StagedRuntimeLibFile)"
          DestinationFiles="@(_StagedRuntimeLibFile->'$(MicrosoftNetCoreAppRuntimePackRidLibTfmDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          UseHardlinksIfPossible="true"
          PrecomputationMode="Dynamic" />
  </Target>

  <!-- Copy the intellisense file to the targeting pack directory. -->
  <Target Name="CopyDocumentationFiles"
          AfterTargets="Build"
          DependsOnTargets="CreateSharedFrameworkLayout"
          PrecomputeMerge="CreateSharedFrameworkLayout"
          Deferred="Item:SharedFrameworkAssembly:r;Item:DocumentationFileToCopy:w">
    <ItemGroup>
      <DocumentationFileToCopy Deferred="true"
                               Include="%(SharedFrameworkAssembly.DocFileItem)"
                               Condition="'%(SharedFrameworkAssembly.IsPrivateAssembly)' == 'false' and '%(SharedFrameworkAssembly.DocFileItem)' != ''" />
    </ItemGroup>

    <Copy PrecomputationMode="Dynamic"
          NoPredict="true"
          SourceFiles="@(DocumentationFileToCopy)"
          DestinationFolder="$(MicrosoftNetCoreAppRefPackRefDir)"
          SkipUnchangedFiles="true"
          UseHardlinksIfPossible="true" />
  </Target>

  <Target Name="ValidateSharedFramework"
          AfterTargets="Build"
          DependsOnTargets="CreateSharedFrameworkLayout"
          PrecomputeInputs="$(MicrosoftNetCoreAppRefPackRefDir)#dir;$(MicrosoftNetCoreAppRuntimePackRidLibTfmDir)#dir"
          Deferred="Item:_missingSharedFrameworkFile:r;Item:_missingSharedFrameworkFile:w">
    <ItemGroup>
      <!-- exclude private assemblies from ref-->
      <_expectedRef Include="@(NetCoreAppLibrary)" Condition="!$([System.String]::new('%(Identity)').StartsWith('System.Private'))" />
      <_expectedSharedFrameworkFile Include="@(_expectedRefs->'$(MicrosoftNetCoreAppRefPackRefDir)%(Identity).dll')" />

      <!-- exclude the full facades from expected docs since they have no types -->
      <_expectedDoc Include="@(_expectedRefs)" Exclude="netstandard;@(NetFxReference)" />
      <_expectedSharedFrameworkFile Include="@(_expectedDoc->'$(MicrosoftNetCoreAppRefPackRefDir)%(Identity).xml')" />

      <!-- exclude CoreLib from expected libs, since it's placed in native -->
      <_expectedLib Include="@(NetCoreAppLibrary)" Exclude="System.Private.CoreLib" />
      <_expectedSharedFrameworkFile Include="@(_expectedLib->'$(MicrosoftNetCoreAppRuntimePackRidLibTfmDir)%(Identity).dll')" />

      <!-- Non-deferred clone for Error PrecomputeInputs; deferred items are not expandable there. -->
      <_expectedSharedFrameworkFileInputs Include="@(_expectedSharedFrameworkFile)" />
      <!-- Snapshot lookup into InitItems / :w without replaying a transform at product. -->
      <_expectedSharedFrameworkFile Deferred="true" />

      <_missingSharedFrameworkFile Deferred="true"
                                   Include="@(_expectedSharedFrameworkFile)"
                                   Condition="!Exists('%(Identity)')" />
    </ItemGroup>

    <Error Text="The shared framework files '@(_missingSharedFrameworkFile)' were missing."
           DeferredCondition="'@(_missingSharedFrameworkFile)' != ''"
           PrecomputationMode="Dynamic"
           PrecomputeInputs="@(_expectedSharedFrameworkFileInputs)" />
  </Target>

  <Target Name="GetTrimSharedFrameworkAssembliesInputs"
          DependsOnTargets="ResolveProjectReferences"
          Deferred="Item:SharedFrameworkAssembly:r;Item:SharedFrameworkSuppressionsXml:w">
    <PropertyGroup>
      <SharedFrameworkAssembliesTrimDir>$([MSBuild]::NormalizeDirectory('$(IntermediateOutputPath)', 'illink-$(TargetArchitecture)'))</SharedFrameworkAssembliesTrimDir>
      <SharedFrameworkAssembliesTrimMarkerFile>$(SharedFrameworkAssembliesTrimDir)linker-marker.txt</SharedFrameworkAssembliesTrimMarkerFile>
      <SharedFrameworkSuppressionsResponseFile>$(SharedFrameworkAssembliesTrimDir)suppressions.rsp</SharedFrameworkSuppressionsResponseFile>
    </PropertyGroup>

    <ItemGroup>
      <SharedFrameworkSuppressionsXml Deferred="true"
                                      Include="%(SharedFrameworkAssembly.ILLinkSuppressionsXmls)"
                                      Condition="'%(SharedFrameworkAssembly.ILLinkSuppressionsXmls)' != ''" />
      <SharedFrameworkSuppressionsXml Deferred="true"
                                      Include="$(CoreLibSharedDir)ILLink\ILLink.Suppressions.LibraryBuild.xml" />
    </ItemGroup>
  </Target>

  <Target Name="TrimSharedFrameworkAssemblies"
          AfterTargets="Build"
          DependsOnTargets="ResolveProjectReferences;GetTrimSharedFrameworkAssembliesInputs;PrepareForAssembliesTrim"
          Outputs="$(SharedFrameworkAssembliesTrimMarkerFile)"
          Deferred="Item:SharedFrameworkAssembly:r;Item:SharedFrameworkAssembly:w;Item:SharedFrameworkSuppressionsXml:r;Item:_SharedFrameworkSuppressionArgument:w;Item:_SharedFrameworkSuppressionArgument:r;Item:_SharedFrameworkRootAssemblyName:w;Item:_SharedFrameworkRootAssemblyName:r">
    <Message Text="$(MSBuildProjectName) -> Trimming $(TargetRid) shared framework assemblies with ILLinker..." Importance="high" />

    <PropertyGroup>
      <SharedFrameworkILLinkArgs>$(ILLinkArgs)</SharedFrameworkILLinkArgs>
      <SharedFrameworkILLinkArgs>$(SharedFrameworkILLinkArgs) -b true</SharedFrameworkILLinkArgs>
    </PropertyGroup>

    <ItemGroup>
      <SharedFrameworkAssembly Deferred="true" RootMode="library" />
      <_SharedFrameworkSuppressionArgument Deferred="true"
                                           Include="--link-attributes &quot;%(SharedFrameworkSuppressionsXml.Identity)&quot;" />
      <_SharedFrameworkRootAssemblyName Deferred="true"
                                        Include="%(SharedFrameworkAssembly.Filename)">
        <RootMode>library</RootMode>
      </_SharedFrameworkRootAssemblyName>
    </ItemGroup>

    <MakeDir Directories="$(SharedFrameworkAssembliesTrimDir)" />
    <WriteLinesToFile PrecomputationMode="Dynamic"
                      PrecomputeOutputs="$(SharedFrameworkSuppressionsResponseFile)"
                      File="$(SharedFrameworkSuppressionsResponseFile)"
                      Lines="@(_SharedFrameworkSuppressionArgument)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ILLink PrecomputationMode="Dynamic"
            AssemblyPaths="@(SharedFrameworkAssembly)"
            RootAssemblyNames="@(_SharedFrameworkRootAssemblyName)"
            OutputDirectory="$(SharedFrameworkAssembliesTrimDir)"
            ExtraArgs="$(SharedFrameworkILLinkArgs) @&quot;$(SharedFrameworkSuppressionsResponseFile)&quot;"
            ToolExe="$(_DotNetHostFileName)"
            ToolPath="$(_DotNetHostDirectory)" />

    <!-- Create a marker file which serves as the target's output to enable incremental builds. -->  
    <Touch Files="$(SharedFrameworkAssembliesTrimMarkerFile)"
           AlwaysCreate="true" />
  </Target>

</Project>
