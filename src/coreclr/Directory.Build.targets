<Project>

  <Import Project="..\..\Directory.Build.targets" />

  <ItemGroup Condition="'$(UsingMicrosoftNoTargetsSdk)' != 'true'">
    <_DebugSymbolToMove Include="@(DebugSymbolsProjectOutputGroupOutput->Metadata('FinalOutputPath'))"
                        FolderName="$([System.IO.Directory]::GetParent('%(Identity)').Name)" />
    <_DebugSymbolToMoveToExclude Include="@(_DebugSymbolToMove->WithMetadataValue('FolderName', 'aotsdk'))" />
    <_DebugSymbolToMoveToUpdate Include="@(_DebugSymbolToMove)"
                                Exclude="@(_DebugSymbolToMoveToExclude)" />
    <!-- Remove the FolderName metadata for projects that don't reside under an aotsdk folder. -->
    <_DebugSymbolToMove Update="@(_DebugSymbolToMoveToUpdate)"
                        FolderName="" />
    <_DebugSymbolToMove Update="@(_DebugSymbolToMove)"
                        FolderName="$(CoreClrPdbStagingSubdirectory)"
                        Condition="'$(CoreClrPdbStagingSubdirectory)' != ''" />
    <_DebugSymbolToMove Update="@(_DebugSymbolToMove)"
                        Destination="$(RuntimeBinDir)PDB\%(FolderName)\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Record each OutDir PDB as a GenerateOutDir file output so leftovers are scrubbed and producer-owned. -->
  <PropertyGroup Condition="'$(_DebugSymbolsProduced)' == 'true'">
    <CopyFilesToOutputDirectoryPrecomputeOutputs>$(CopyFilesToOutputDirectoryPrecomputeOutputs);@(_DebugSymbolToMove)</CopyFilesToOutputDirectoryPrecomputeOutputs>
  </PropertyGroup>

  <!-- Consolidate all PDBs into a single location, except the aotsdk PDBs, as S.P.C will overwrite the coreclr PDBs.
       Stage from DebugSymbolsProjectOutputGroupOutput (obj PDB, CoreCompile file output). OutDir PDB inputs are
       flattened onto $(OutDir)#dir because .pdb is treated as an auxiliary sidecar, and exclusive file outputs
       are not members of that sealed directory view. -->
  <Target Name="MoveSymbolFiles"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="_CheckForCompileOutputs"
          Inputs="@(DebugSymbolsProjectOutputGroupOutput)"
          Outputs="@(_DebugSymbolToMove->Metadata('Destination'))"
          PrecomputeInputs="@(DebugSymbolsProjectOutputGroupOutput)"
          Condition="'$(_DebugSymbolsProduced)' == 'true'">
    <Copy SourceFiles="@(DebugSymbolsProjectOutputGroupOutput)"
          DestinationFiles="@(_DebugSymbolToMove->Metadata('Destination'))"
          UseHardlinksIfPossible="false" />
  </Target>

  <!-- CopyLocal related .pdb items are OutDir paths. Those are exclusive GenerateOutDir file
       outputs, so the referenced OutDir directory view does not contain them. Consume each
       referenced DebugSymbolsProjectOutputGroup obj PDB (CoreCompile file output) instead. -->
  <Target Name="_CaptureReferencedObjPdbsForCopyLocal"
          AfterTargets="ResolveAssemblyReferences"
          PrecomputeMerge="ResolveReferences"
          Condition="'$(IsPrecomputePhase)' == 'true' and '@(_MSBuildProjectReferenceExistent)' != ''"
          Deferred="Item:_OutDirPdbToObj:w">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="DebugSymbolsProjectOutputGroup"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             Condition="'$(IsPrecomputePhase)' == 'true' and '%(_MSBuildProjectReferenceExistent.BuildReference)' == 'true' and '%(_MSBuildProjectReferenceExistent.ReferenceOutputAssembly)' != 'false'"
             ContinueOnError="!$(BuildingProject)"
             SkipNonexistentTargets="true"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)">
      <Output TaskParameter="TargetOutputs" ItemName="_ReferencedDebugSymbolObjPdbsRaw" />
    </MSBuild>
    <!-- Replay cannot see IsPrecomputePhase. Literal false skips this at product; meta already ran it. -->
    <ItemGroup DeferredCondition="false">
      <_ReferencedDebugSymbolObjPdbsRaw>
        <ObjPdb>%(Identity)</ObjPdb>
      </_ReferencedDebugSymbolObjPdbsRaw>
      <_OutDirPdbToObj Deferred="true" Include="@(_ReferencedDebugSymbolObjPdbsRaw->'%(FinalOutputPath)')" />
      <ReferenceCopyLocalPathsDeps Include="@(_ReferencedDebugSymbolObjPdbsRaw)" />
    </ItemGroup>
  </Target>

  <Target Name="_CopyLocalFromReferencedObjPdbs"
          BeforeTargets="_CopyFilesMarkedCopyLocal;_Compute_CopyFilesMarkedCopyLocal_ReferencesCopiedInThisBuild"
          PrecomputeMerge="GenerateOutDir"
          Condition="'$(IsPrecomputePhase)' != 'true' and '$(TL_DEFERRED_PATH)' != ''"
          Deferred="Item:_OutDirPdbToObj:r;Item:ReferenceCopyLocalPaths:r;Item:ReferenceCopyLocalPaths:w">
    <ItemGroup>
      <_CopyLocalPdbReplace Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.pdb'" />
      <_CopyLocalPdbReplace Update="@(_OutDirPdbToObj)" ObjPdb="%(_OutDirPdbToObj.ObjPdb)" />
      <ReferenceCopyLocalPaths Remove="@(_CopyLocalPdbReplace)" Condition="'%(ObjPdb)' != ''" />
      <ReferenceCopyLocalPaths Include="@(_CopyLocalPdbReplace->'%(ObjPdb)')" Condition="'%(ObjPdb)' != ''" />
    </ItemGroup>
  </Target>

  <!-- Import targets here to have TargetPath and other macros defined. Limit to CoreLib. -->
  <Import Condition="'$(MSBuildProjectName)' == 'System.Private.CoreLib' or '$(IsNativeAotProject)' == 'true'" Project="$(RepositoryEngineeringDir)illink.targets" />
  <Import Project="$(RepositoryEngineeringDir)liveILLink.targets" />

</Project>
