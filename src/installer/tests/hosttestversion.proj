<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.Build.NoTargets" />

  <PropertyGroup>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProductVersionProject Include="$(MSBuildThisFileDirectory)..\pkg\sfx\Microsoft.NETCore.App\Microsoft.NETCore.App.Ref.sfxproj" />
    <ProjectReference Include="@(ProductVersionProject)"
                      BuildReference="false"
                      Private="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.Build.NoTargets" />

  <ItemGroup>
    <ProjectReferenceTargets Remove="Build" />
    <ProjectReferenceTargets Include="Build"
                             Targets="ReturnProductVersion" />
  </ItemGroup>

  <Target Name="Build"
          Returns="@(_ProductVersion)">
    <MSBuild Projects="@(ProductVersionProject)"
             Targets="ReturnProductVersion">
      <Output TaskParameter="TargetOutputs"
              ItemName="_ProductVersion" />
    </MSBuild>
  </Target>

</Project>
