<Project Sdk="Microsoft.Build.Traversal">

  <!-- The graph explicitly contains the restored coordinator reference; do not add it again with the normal Build protocol. -->
  <PropertyGroup Condition="'$(IsGraphBuild)' == 'true'">
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <!-- Build all test project assets. Output will be used by tests. -->
  <ItemGroup>
    <HostPretestPublishProject Include="hostpretestpublish.proj" />
    <ProjectReference Include="$(InstallerProjectRoot)tests\Assets\Projects\**\*.csproj" />
    <ProjectReference Include="@(HostPretestPublishProject)"
                      AdditionalProperties="OutputPath=$(TestArtifactsOutputRoot)sharedFrameworkPublish/;RuntimeFlavor=$(RuntimeFlavor)">
      <Build Condition="'$(IsGraphBuild)' != 'true'">false</Build>
    </ProjectReference>
  </ItemGroup>

  <!-- Set up the shared framework copy the tests should use. -->
  <Target Name="SetUpSharedFrameworkPublish"
          BeforeTargets="Build">
    <MSBuild Projects="@(HostPretestPublishProject)"
             Targets="Build"
             Properties="OutputPath=$(TestArtifactsOutputRoot)sharedFrameworkPublish/;RuntimeFlavor=$(RuntimeFlavor)" />
  </Target>
</Project>
